@using PortfolioSite.Models

<section id="experience" class="py-24" aria-labelledby="experience-heading">
    <div class="mb-12">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.25em] text-crt/80">// Quest log</p>
        <h2 id="experience-heading" class="font-pixel text-lg uppercase leading-relaxed text-copper sm:text-xl">Work history</h2>
        <p class="mt-4 text-neutral-400">The path so far, pinned to the wall.</p>
    </div>

    <div class="space-y-8">
        @foreach (var experience in SiteContent.Experiences)
        {
            <article class="pixel-panel p-6 sm:p-8">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                    <div class="sm:w-1/4">
                        <p class="font-mono text-sm text-lamp"><span class="text-copper" aria-hidden="true">▸ </span>@experience.Date</p>
                    </div>
                    <div class="sm:w-3/4">
                        <h3 class="mb-2 font-display text-2xl font-semibold text-neutral-100">
                            @experience.Role — <span class="text-lamp">@experience.Company</span>
                        </h3>
                        <p class="mb-4 leading-relaxed text-neutral-300">@experience.Description</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var skill in experience.Skills)
                            {
                                <span class="tech-tag">@skill</span>
                            }
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
