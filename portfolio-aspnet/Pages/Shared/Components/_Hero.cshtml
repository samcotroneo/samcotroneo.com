@using PortfolioSite.Models
@{
    var kitchen = SiteContent.Worlds.First(w => w.Slug == "kitchen");
    var control = SiteContent.Worlds.First(w => w.Slug == "control-room");
    var arcade = SiteContent.Worlds.First(w => w.Slug == "arcade");
}

<section id="top" class="relative flex min-h-svh flex-col items-center justify-center overflow-hidden pb-28 pt-6 sm:pt-8" aria-label="Introduction">
