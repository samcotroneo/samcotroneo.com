@using System.Text.Json
@using PortfolioSite.Models

@{
    var attributes = SiteContent.Attributes;
    var attributesJson = JsonSerializer.Serialize(attributes);
    var initialAttribute = attributes.Count > 0 ? attributes[0] : "Software Engineer";
}

<div class="border-b border-neutral-900 lg:mb-35">
    <div class="flex flex-wrap">
        <div class="w-full lg:w-1/2">
            <div class="flex flex-col items-center lg:items-start">
                <h1 class="pb-8 text-5xl font-thin tracking-tight lg:mt-16 lg:text-8xl">
                    Sam Cotroneo
                </h1>
                <span class="text-2xl text-center lg:text-left">Hi there! I'm a </span>
                <span class="hero-attribute pb-24 lg:pb-16 text-3xl tracking-tight text-center lg:self-start" data-attributes='@Html.Raw(attributesJson)' data-interval="3200" aria-live="polite">
                    <span class="hero-attribute__card">
                        <span class="hero-attribute__face hero-attribute__face--front justify-center lg:justify-start bg-gradient-to-r bg-clip-text text-transparent">
                            @initialAttribute
                        </span>
                        <span class="hero-attribute__face hero-attribute__face--back justify-center lg:justify-start bg-gradient-to-r bg-clip-text text-transparent">
                            @initialAttribute
                        </span>
                    </span>
                </span>
                <span class="hidden from-pink-300 via-slate-500 to-purple-500 from-sky-300 via-emerald-300 to-cyan-400 from-amber-300 via-orange-400 to-red-500 from-violet-300 via-fuchsia-400 to-green-400 from-red-500 via-slate-300 to-rose-400"></span>
            </div>
        </div>
        <div class="w-full lg:w-1/2 flex items-center justify-center">
            <div class="relative size-80 lg:size-96">
                <div class="hero-glow" aria-hidden="true"></div>
                <div class="hero-sparkles" aria-hidden="true"></div>
                <img src="~/assets/ProfilePicture.png" alt="Profile Picture" class="absolute top-0 left-0 z-10" />
            </div>
        </div>
    </div>
</div>
