                                <span class="flex aspect-square w-16 border border-white/25 shadow-sm transition-transform group-hover:-translate-y-1" style="background-color:@control.Color"></span>
                                <span class="font-mono text-base uppercase tracking-wide" style="color:@control.Color">Control</span>
                            </button>
                            <button type="button"
                                    class="world-window group flex items-center gap-4 rounded bg-white/5 p-3 outline-none transition-colors hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-white"
                                    data-world="@arcade.Slug"
                                    data-color="@arcade.Color"
                                    onclick="document.getElementById('world-@arcade.Slug').scrollIntoView({behavior:'smooth',block:'start'})">
                                <span class="flex aspect-square w-16 border border-white/25 shadow-sm transition-transform group-hover:-translate-y-1" style="background-color:@arcade.Color"></span>
                                <span class="font-mono text-base uppercase tracking-wide" style="color:@arcade.Color">@arcade.Name</span>
                            </button>
                        </div>
                    </div>
                </foreignObject>
            </g>

            <g fill="#f4a261" opacity="0.35" filter="url(#m-dustBlur)">
                <circle cx="280" cy="380" r="1.5" />
                <circle cx="330" cy="320" r="1" />
                <circle cx="420" cy="430" r="1.2" />
                <circle cx="220" cy="290" r="0.9" />
                <circle cx="500" cy="240" r="1" />
            </g>
        </svg>

        <!-- Title / tagline -->
        <div class="pointer-events-none absolute bottom-[18%] sm:bottom-[12%] left-1/2 z-10 w-full -translate-x-1/2 text-center">
            <h1 class="font-hero text-2xl font-medium uppercase tracking-[0.04em] text-copper sm:text-4xl md:text-5xl">
                Sam Cotroneo
            </h1>
            <p class="mt-2 font-display text-[11px] uppercase tracking-[0.16em] text-crt/70 sm:text-xs">
                Coder Den · Pick a Project
            </p>
        </div>

        <!-- Scroll hint -->
        <div class="absolute bottom-[5%] left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-1 opacity-60">
            <span class="font-display text-[10px] uppercase tracking-[0.2em] text-crt/80">Scroll</span>
            <svg class="h-4 w-4 animate-float text-crt/80" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
        </div>
    </div>
</section>
