@using PortfolioSite.Models

<section id="about" class="py-24" aria-labelledby="about-heading">
    <div class="mx-auto max-w-3xl">
        <div class="relative room-panel p-8 sm:p-10">
            <div class="absolute -top-3 left-8 h-6 w-20 -rotate-3 bg-lamp/80" aria-hidden="true"></div>
            <div class="absolute -top-3 right-12 h-6 w-16 rotate-2 bg-crt/80" aria-hidden="true"></div>

            <h2 id="about-heading" class="mb-6 font-display text-4xl font-semibold text-neutral-100">About me</h2>
            <div class="space-y-4 text-lg leading-relaxed text-neutral-300">
                @foreach (var content in SiteContent.AboutContent)
                {
                    var yearsText = $"{(DateTime.Now - SiteContent.CareerStartDate).TotalDays / 365:F0}";
                    var yearsSpan = $"<span class=\"js-experience-years font-mono text-lamp\" data-start=\"{SiteContent.CareerStartDate:yyyy-MM-dd}\">{yearsText}</span>";
                    var renderedContent = content.Replace("{years}", yearsSpan);
                    <p>
                        @Html.Raw(renderedContent)
                    </p>
                }
            </div>
        </div>
    </div>
</section>
