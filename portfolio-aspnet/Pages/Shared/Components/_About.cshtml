@using PortfolioSite.Models

<div class="border-b border-neutral-900 pb-24">
    <h2 class="mt-20 mb-16 text-center text-4xl">
        <span class="bg-gradient-to-r from-pink-300 via bg-slate-500 to-purple-500 bg-clip-text text-4xl tracking-tight text-transparent">
            About
        </span> Me
    </h2>
    <div class="flex flex-wrap">
        <div class="mx-auto">
            @foreach (var content in SiteContent.AboutContent)
            {
                var yearsText = $"{(DateTime.Now - SiteContent.CareerStartDate).TotalDays / 365:F0}";
                var yearsSpan = $"<span class=\"js-experience-years\" data-start=\"{SiteContent.CareerStartDate:yyyy-MM-dd}\">{yearsText}</span>";
                var renderedContent = content.Replace("{years}", yearsSpan);
                <p class="my-2 max-w-xl py-2 text-center tracking-tight">
                    @Html.Raw(renderedContent)
                </p>
            }
        </div>
    </div>
</div>
