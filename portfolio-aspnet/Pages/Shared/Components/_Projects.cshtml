@using PortfolioSite.Models

<div id="projects" class="border-b border-neutral-700 pb-24">
    <h2 class="my-20 text-center text-4xl">
        <span class="bg-gradient-to-r from-pink-300 via bg-slate-500 to-purple-500 bg-clip-text text-4xl tracking-tight text-transparent">
            Projects
        </span> I'm Building
    </h2>
    <div>
        @foreach (var project in SiteContent.Projects)
        {
            <div class="mb-8 flex flex-wrap lg:justify-center">
                <div class="w-full lg:w-1/4">
                    <img class="rounded-2xl mb-4 w-40 h-40" style="image-rendering: pixelated" src="~/@project.Image" alt="@project.Title" />
                </div>
                <div class="w-full max-w-xl lg:w-3/4">
                    <h6 class="mb-2 font-semibold">@project.Title</h6>
                    <p class="mb-4 text-neutral-400">@project.Description</p>
                    <div class="flex flex-wrap">
                        @foreach (var technology in project.Technologies)
                        {
                            <span class="whitespace-nowrap rounded bg-neutral-900 text-purple-500 text-sm font-medium mr-2 mt-2 px-2 py-1">
                                @technology
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
