@using PortfolioSite.Models

@{
    // Winning card art per world (picked from the variant lab)
    var cardSkins = new Dictionary<string, (string Variant, string Image)>
    {
        { "kitchen", ("k1", "kitchen-1") },
        { "arcade", ("a2", "arcade-2") },
        { "control-room", ("c4", "control-4") },
    };
}

<section id="worlds" class="py-24" aria-labelledby="worlds-heading">
    <div class="mb-12 flex items-end justify-between border-b border-white/10 pb-6">
        <div>
            <p class="mb-4 font-mono text-xs uppercase tracking-[0.25em] text-crt/80">// Save points</p>
            <h2 id="worlds-heading" class="font-pixel text-lg uppercase leading-relaxed text-copper sm:text-xl">Project worlds</h2>
            <p class="mt-4 max-w-xl text-neutral-400">Each window on the monitor is a corner of things I'm building.</p>
        </div>
        <a href="#top" class="hidden font-mono text-sm text-neutral-500 hover:text-lamp sm:inline">↑ back to desk</a>
    </div>

    <div class="space-y-10">
        @foreach (var world in SiteContent.Worlds)
        {
            <article id="world-@world.Slug"
                     class="world-section world-theme-@world.Slug relative scroll-mt-28 py-10 sm:py-14"
                     data-world="@world.Slug"
                     data-world-color="@world.Color"
                     aria-label="@world.Name projects">
                <div class="world-bg-layer pointer-events-none absolute inset-x-0 -inset-y-[160px] z-0 will-change-transform" aria-hidden="true">
                    <canvas class="world-bg-canvas h-full w-full" data-bg-slug="@world.Slug"></canvas>
                    <img class="world-bg-img absolute inset-0 h-full w-full object-cover" src="~/img/scenes/@(world.Slug).png" alt="" loading="lazy" onerror="this.remove()" />
                </div>
                <canvas class="world-particles pointer-events-none absolute inset-0 z-[1] h-full w-full" data-particle-slug="@world.Slug" aria-hidden="true"></canvas>

                <div class="world-inner relative z-10 mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 lg:px-12" style="--world-glow: @world.Color;">
                    <header class="world-header flex flex-wrap items-center gap-4 rounded-xl border border-white/10 bg-den-dark/80 p-4 backdrop-blur-sm sm:p-5">
                        <span class="flex h-14 w-14 items-center justify-center rounded-xl text-3xl" style="background-color: @(world.Color + "26"); box-shadow: 0 0 24px @(world.Color + "1A")">
                            @world.Icon
                        </span>
                        <div>
                            <h3 class="font-display text-3xl font-semibold text-neutral-100">@world.Name</h3>
                            <p class="text-neutral-400">@world.Description</p>
                        </div>
                        <div class="hidden h-px flex-1 bg-gradient-to-r from-white/10 to-transparent sm:block"></div>
                    </header>

                    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                        @foreach (var project in world.Projects)
                        {
                            var skin = cardSkins[world.Slug];
                            <article class="wcard wcard--@skin.Variant transition-transform hover:-translate-y-1">
                                <img class="wcard__bg" src="~/img/ui/cards/@(skin.Image).png" alt="" aria-hidden="true" loading="lazy" />
                                <h4 class="wcard__title font-pixel">@project.Title</h4>
                                <div class="wcard__screen">
                                    @if (!string.IsNullOrEmpty(project.Image))
                                    {
                                        <img src="~/@project.Image" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span aria-hidden="true">@world.Icon</span>
                                    }
                                </div>
                                <div class="wcard__body">
                                    <p class="wcard__desc">@project.Description</p>
                                    <div class="wcard__tags">
                                        @foreach (var technology in project.Technologies)
                                        {
                                            <span class="wcard__tag">@technology</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(project.Link))
                                    {
                                        <a href="@project.Link" target="_blank" rel="noopener noreferrer" class="wcard__link">View project →</a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
</section>
