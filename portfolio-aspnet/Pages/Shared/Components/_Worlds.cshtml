@using PortfolioSite.Models

<section id="worlds" class="py-24" aria-labelledby="worlds-heading">
    <div class="mb-12 flex items-end justify-between border-b border-white/10 pb-6">
        <div>
            <h2 id="worlds-heading" class="font-display text-4xl font-semibold text-neutral-100 sm:text-5xl">Project worlds</h2>
            <p class="mt-2 max-w-xl text-neutral-400">Each window on the monitor is a corner of things I'm building.</p>
        </div>
        <a href="#top" class="hidden font-mono text-sm text-neutral-500 hover:text-lamp sm:inline">↑ back to desk</a>
    </div>

    <div class="space-y-16">
        @foreach (var world in SiteContent.Worlds)
        {
            <article id="world-@world.Slug" class="room-panel scroll-mt-28 p-6 sm:p-8" data-world-section="@world.Slug">
                <header class="mb-8 flex flex-wrap items-center gap-4">
                    <span class="flex h-14 w-14 items-center justify-center rounded-xl text-3xl" style="background-color: @(world.Color + "26"); box-shadow: 0 0 24px @(world.Color + "1A")">
                        @world.Icon
                    </span>
                    <div>
                        <h3 class="font-display text-3xl font-semibold text-neutral-100">@world.Name</h3>
                        <p class="text-neutral-400">@world.Description</p>
                    </div>
                    <div class="hidden h-px flex-1 bg-gradient-to-r from-white/10 to-transparent sm:block"></div>
                </header>

                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    @foreach (var project in world.Projects)
                    {
                        <div class="flex flex-col rounded-xl border border-white/10 bg-den-dark/60 p-5 transition-transform hover:-translate-y-1">
                            @if (!string.IsNullOrEmpty(project.Image))
                            {
                                <div class="mb-4 flex h-40 items-center justify-center rounded-lg bg-den-light/50">
                                    <img src="~/@project.Image" alt="" class="max-h-full max-w-full object-contain" loading="lazy" />
                                </div>
                            }
                            else
                            {
                                <div class="mb-4 flex h-40 items-center justify-center rounded-lg bg-den-light/50">
                                    <span class="text-4xl">@world.Icon</span>
                                </div>
                            }
                            <h4 class="mb-2 font-display text-xl font-semibold text-neutral-100">@project.Title</h4>
                            <p class="mb-4 flex-1 text-sm leading-relaxed text-neutral-400">@project.Description</p>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var technology in project.Technologies)
                                {
                                    <span class="tech-tag" style="color: @(world.Color + "CC"); border-color: @(world.Color + "33")">@technology</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(project.Link))
                            {
                                <a href="@project.Link" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1 text-sm font-medium hover:underline" style="color: @world.Color">
                                    View project
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                                </a>
                            }
                        </div>
                    }
                </div>
            </article>
        }
    </div>
</section>
