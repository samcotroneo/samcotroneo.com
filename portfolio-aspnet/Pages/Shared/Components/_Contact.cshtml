@using PortfolioSite.Models

<div class="border-b border-neutral-800 pb-24">
    <h2 class="my-20 text-center text-4xl">
        <span class="bg-gradient-to-r from-pink-300 via bg-slate-500 to-purple-500 bg-clip-text text-4xl tracking-tight text-transparent">
            Get in Touch
        </span>
    </h2>
    <div class="text-center tracking-tight">
        <p class="my-4">@SiteContent.Contact.Description</p>
        <a href="mailto:@SiteContent.Contact.Email" class="border-b text-purple-500">
            @SiteContent.Contact.Email
        </a>
    </div>
</div>
